# Read about configuration, here:
# https://craftcms.com/docs/5.x/configure.html

# The application ID used to to uniquely store session and cache data, mutex locks, and more
CRAFT_APP_ID=

# The environment Craft is currently running in (dev, staging, production, etc.)
CRAFT_ENVIRONMENT=production

# Database connection settings
CRAFT_DB_DRIVER=mysql
CRAFT_DB_SERVER=127.0.0.1
CRAFT_DB_PORT=3306
CRAFT_DB_DATABASE=
CRAFT_DB_USER=root
CRAFT_DB_PASSWORD=
CRAFT_DB_SCHEMA=public
CRAFT_DB_TABLE_PREFIX=

# General settings
CRAFT_SECURITY_KEY=
CRAFT_DEV_MODE=false
CRAFT_ALLOW_ADMIN_CHANGES=false
CRAFT_DISALLOW_ROBOTS=false
CRAFT_HEADLESS_MODE=true
PRIMARY_SITE_URL=https://www.abbaye-du-val-dieu.be/cms

# GitHub Actions rebuild integration. Use a fine-grained token restricted to
# this repository with Contents: write. Never commit the real token.
GITHUB_DISPATCH_REPOSITORY=crokstudio/val-dieu
GITHUB_DISPATCH_TOKEN=

# Authenticated SMTP shared by Craft and the public guided-visits form.
# In production, prefer CRAFT_SECRETS_PATH pointing to the private PHP file
# described in docs/production-migration.md instead of storing secrets here.
CRAFT_SECRETS_PATH=
VALDIEU_SMTP_HOST=
VALDIEU_SMTP_PORT=587
VALDIEU_SMTP_ENCRYPTION=tls
VALDIEU_SMTP_USERNAME=
VALDIEU_SMTP_PASSWORD=
VALDIEU_SMTP_FROM_EMAIL=infotourist@val-dieu.net
VALDIEU_SMTP_FROM_NAME=Val-Dieu
VALDIEU_FORM_TO_EMAIL=infotourist@val-dieu.net
