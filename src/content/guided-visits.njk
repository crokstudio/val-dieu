---
pagination:
  data: locales
  size: 1
  alias: locale
permalink: "{{ locale.code }}/guided-visits/index.html"
eleventyComputed:
  language: "{{ locale.language }}"
  currentLocale: "{{ locale.code }}"
  currentPath: "/guided-visits"
---

{% extends "layouts/base.njk" %}

{% set pageTitle = ('Book' | t(currentLocale)) %}

{% block content %}

    <div class="section grid-layout">

        <div class="grid-layout-5 grid-layout-tablet-8 grid-layout-desktop-10 grid-layout-wide-12 guided-visits--intro">
            <div class="guided-visits--intro-title">
                <h1>{{ 'Guided Visits' | t(currentLocale) }}</h1>
            </div>
            <p class="guided-visits--intro-txt">{{ 'BP-introText' | t(currentLocale) }}</p>
        </div>

    </div>

    <div class="section grid-layout guided-visits--book">

        <h2>{{ 'BP-formTitle' | t(currentLocale) }}</h2>

        <div class="book--smallGroups">
            <h3 class="book--title">{{ 'Group' | t(currentLocale) }} < 15</h3>
            <div id="ConstellationWidgetContainer0073a4a9-7782-427d-a499-c7f760733bef" style="width:100%" title="Abbaye du Val-Dieu" data-id-projet='0073a4a97782427da499c7f760733bef'>Chargement en cours...</div> <script type="text/javascript" src="https://reservation.elloha.com/Scripts/widget-loader.min.js?v=42"></script> <script type="text/javascript">var constellationWidgetUrl0073a4a97782427da499c7f760733bef, constellationTypeModule0073a4a97782427da499c7f760733bef; constellationWidgetUrl0073a4a97782427da499c7f760733bef = 'https://reservation.elloha.com/Widget/BookingEngine/0073a4a9-7782-427d-a499-c7f760733bef?idoi=86fae45e-deec-4e8b-bc38-6d0dc4bc8f45&culture=fr-FR'; constellationTypeModule0073a4a97782427da499c7f760733bef=1; constellationWidgetLoad('ConstellationWidgetContainer0073a4a9-7782-427d-a499-c7f760733bef'); constellationWidgetAddEvent(window, "resize", function () { constellationWidgetSetAppearance('ConstellationWidgetContainer0073a4a9-7782-427d-a499-c7f760733bef'); });</script>
        </div>
        <div class="book--bigGroups">
            <h3 class="book--title">{{ 'Group' | t(currentLocale) }} > 15</h3>
            <form action="/api/guided-visits.php" method="post" class="guided-visits--form">
                <input type="hidden" name="locale" value="{{ currentLocale }}">
                <p hidden aria-hidden="true">
                    <label for="website">Website</label>
                    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
                </p>
                <fieldset>
                     <legend>{{ 'BookingRequest' | t(currentLocale) }}</legend>

                    <p>
                        <label class="form--label" for="visit-date">{{ 'PreferredDate' | t(currentLocale) }}</label>
                        <input type="date" id="visit-date" name="visit_date" required>
                    </p>

                    <p>
                        <label class="form--label" for="visit-time">{{ 'PreferredTime' | t(currentLocale) }}</label>
                        <input type="time" id="visit-time" name="visit_time" required>
                    </p>

                    <p>
                        <label class="form--label" for="group-name">{{ 'GroupName' | t(currentLocale) }}</label>
                        <input type="text" id="group-name" name="group_name" required>
                    </p>

                    <p>
                        <label class="form--label" for="adult-count">{{ 'AdultNumber' | t(currentLocale) }}</label>
                        <input type="number" id="adult-count" name="adult_count" min="0" required>
                    </p>

                    <p>
                        <label class="form--label" for="teen-count">{{ 'YoungNumber' | t(currentLocale) }}</label>
                        <input type="number" id="teen-count" name="teen_count" min="0" required>
                    </p>

                    <p>
                        <label class="form--label" for="child-count">{{ 'KidsNumber' | t(currentLocale) }}</label>
                        <input type="number" id="child-count" name="child_count" min="0" required>
                    </p>

                    <fieldset class="form--visit-type">
                        <legend>{{ 'TourType' | t(currentLocale) }}</legend>

                        <p>
                            <input type="radio" id="visit-abbey" name="visit_type" value="Visite de l'abbaye" required>
                            <label for="visit-abbey">{{ 'AbbeyTour' | t(currentLocale) }}</label>
                        </p>

                        <p>
                            <input type="radio" id="visit-combined" name="visit_type" value="Visite combinée abbaye et brasserie">
                            <label for="visit-combined">{{ 'AbbeyBreweryTour' | t(currentLocale) }}</label>
                        </p>
                    </fieldset>

                    <p>
                        <label class="form--label" for="email">{{ 'Email' | t(currentLocale) }}</label>
                        <input type="email" id="email" name="email" required>
                    </p>

                    <p>
                        <label class="form--label" for="phone">{{ 'PhoneNumber' | t(currentLocale) }}</label>
                        <input type="tel" id="phone" name="phone" required>
                    </p>

                    <p>
                        <label class="form--label" for="message">{{ 'AdditionalMessage' | t(currentLocale) }}</label>
                        <textarea id="message" name="message" rows="5"></textarea>
                    </p>
                </fieldset>

                <section aria-labelledby="visit-prices-title">
                    <h4 id="visit-prices-title">{{ 'Prices&Info' | t(currentLocale) }}</h4>

                    <p>
                        <strong>{{ 'AbbeyTour' | t(currentLocale) }}</strong><br>
                        {{ 'AbbeyTourInfo' | t(currentLocale) }}
                    </p>

                    <p>
                        <strong>{{ 'AbbeyBreweryTour' | t(currentLocale) }}</strong><br>
                        {{ 'AbbeyBreweryTourInfo' | t(currentLocale) }}
                        <br>
                        {{ 'AbbeyBreweryTourInfo2' | t(currentLocale) }}

                    </p>

                    <p>
                        <strong>{{ 'Information' | t(currentLocale) }} :</strong><br>
                        Tel : <a href="tel:+3287692828">+32(0)87 69 28 28</a><br>
                        Email : <a href="mailto:infotourist@val-dieu.net">infotourist@val-dieu.net</a><br>
                        Val-Dieu, 227 à 4880 Aubel
                    </p>
                </section>

                <button type="submit">{{ 'SendRequest' | t(currentLocale) }}</button>
            </form>
        </div>

        

    </div>


    <div class="section grid-layout">
        <div class="guided-visits--eat">
            <a href="https://www.val-dieu.com/casse-croute/" target="_blank" class="guided-visits--eat-link">
                <h4>{{ 'BP-bookRestaurant' | t(currentLocale) }}</h4>
            </a>
        </div>
    </div>


{% endblock %}
